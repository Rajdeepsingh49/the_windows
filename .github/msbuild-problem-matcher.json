{
  "problemMatcher": [
    {
      "owner": "msbuild",
      "pattern": [
        {
          "regexp": "^\\s*(.+?)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+([A-Za-z]+\\d+):\\s+(.+?)(\\s+\\[.+\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
